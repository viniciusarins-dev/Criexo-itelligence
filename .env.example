# Supabase — Project Settings → API. A chave publicável (ou "anon") é segura
# no navegador porque todo acesso passa por RLS.
# NUNCA coloque a service_role key em variáveis NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Inteligência artificial (opcional; somente no servidor — nunca NEXT_PUBLIC_*).
# Sem estas quatro variáveis, as sugestões da IA aparecem como "não configuradas"
# e as ideias são cadastradas manualmente. Plano gratuito do Gemini: o Google usa
# o conteúdo enviado para melhorar seus produtos — o sistema envia só segmento,
# produto, objetivo e capacidade produtiva, nunca dados pessoais.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
# Máximo de chamadas à IA por dia (fuso de São Paulo), somando todos os usuários.
AI_DAILY_REQUEST_LIMIT=

# Fontes públicas (opcionais; sem chave). Por padrão usam as instâncias
# públicas do OpenStreetMap/Overpass, Nominatim e BrasilAPI.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# BRASILAPI_URL=https://brasilapi.com.br
# Consultas ao OpenStreetMap por dia (padrão 100, pela política da instância pública).
# OSM_DAILY_QUERY_LIMIT=

# --- Somente testes ---------------------------------------------------------
# Conexão de superusuário com um banco que tenha as migrations aplicadas
# (Supabase local: postgresql://postgres:postgres@127.0.0.1:54322/postgres).
# Os testes de integração rodam em transações desfeitas ao final.
TEST_DATABASE_URL=

# Usuários para os testes E2E: administrador ativo, inativo e membro ativo.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_INACTIVE_EMAIL=
E2E_INACTIVE_PASSWORD=
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
# Opcional: caminho de um Chromium já instalado.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
